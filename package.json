{
  "name": "grafana-pnp-datasource",
  "version": "2.3.1",
  "description": "grafana datasource for pnp4nagios",
  "author": "Sven Nierlein",
  "license": "MIT",
  "packageManager": "yarn@4.9.2",
  "homepage": "https://github.com/sni/grafana-pnp-datasource#readme",
  "bugs": {
    "url": "https://github.com/sni/grafana-pnp-datasource/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sni/grafana-pnp-datasource.git"
  },
  "scripts": {
    "build": "yarn lint && webpack -c ./.config/webpack/webpack.config.ts --env production",
    "dev": "yarn lint && webpack -w -c ./.config/webpack/webpack.config.ts --env development",
    "lint": "eslint --cache .",
    "lint:fix": "yarn run lint --fix",
    "prettier:check": "prettier --list-different \"**/*.{ts,tsx,scss}\"",
    "prettier:write": "prettier --list-different \"**/*.{ts,tsx,scss}\" --write",
    "server": "docker-compose up --build",
    "sign": "npx --yes @grafana/sign-plugin@latest",
    "start": "yarn watch",
    "test": "jest",
    "test:watch": "jest --watch --onlyChanged",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@grafana/eslint-config": "^10.0.0",
    "@grafana/tsconfig": "^1.2.0-rc1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@swc/core": "1.3.75",
    "@swc/helpers": "^0.5.0",
    "@swc/jest": "^0.2.26",
    "@types/jest": "^30.0.0",
    "@types/lodash": "^4.14.194",
    "@types/node": "^18.15.11",
    "@types/react": "^18.2.0",
    "@typescript-eslint/eslint-plugin": "^8.9.0",
    "@typescript-eslint/parser": "^8.9.0",
    "copy-webpack-plugin": "^14.0.0",
    "css-loader": "^6.7.3",
    "eslint": "^10.0.0",
    "eslint-config-prettier": "^10.1.0",
    "eslint-plugin-jsdoc": "^65.3.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.0",
    "fork-ts-checker-webpack-plugin": "^9.1.0",
    "glob": "^13.0.0",
    "identity-obj-proxy": "3.0.0",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "prettier": "^2.8.7",
    "replace-in-file-webpack-plugin": "^1.0.6",
    "style-loader": "3.3.3",
    "swc-loader": "^0.2.3",
    "ts-node": "^10.9.1",
    "typescript": "~5.9.0",
    "webpack": "^5.104.1",
    "webpack-cli": "^5.1.4",
    "webpack-livereload-plugin": "^3.0.2"
  },
  "dependencies": {
    "@grafana/data": "^11.6.0",
    "@grafana/runtime": "^11.6.0",
    "@grafana/ui": "^11.6.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tslib": "2.6.3"
  },
  "resolutions": {
    "@opentelemetry/core": "2.8.0",
    "basic-ftp": "6.2.3",
    "dompurify": "3.4.17",
    "immutable@npm:5.1.5": "5.1.8",
    "moment": "2.31.0",
    "react-use": "17.6.1",
    "uuid@npm:11.0.5": "11.1.1"
  }
}
